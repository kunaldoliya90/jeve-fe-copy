# ---------------------------------------------------------------------------
# Copy to `.env.local` (git-ignored) and fill in. Only VITE_-prefixed vars are
# exposed to the browser bundle — never put a secret in one; they ship to every
# user. Every variable here is validated at startup by src/config/env.ts.
# ---------------------------------------------------------------------------

# Human-readable app name, shown in the shell and document title.
VITE_APP_NAME="JEVE"

# Base URL for API requests. Use a relative path to go through the dev proxy.
# On Vercel there is no proxy: set this to the backend's absolute URL
# (e.g. "https://api.example.com/api") in the project's environment variables.
VITE_API_BASE_URL="/api"

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS="30000"

# Where the dev server proxies /api to. Leave blank to disable the proxy and
# call VITE_API_BASE_URL directly.
VITE_API_PROXY_TARGET="http://127.0.0.1:8000"

# Intercept network calls with MSW in dev so the UI can be built before the
# API exists. "true" | "false"
VITE_ENABLE_API_MOCKING="false"

# Minimum level written to the console: "debug" | "info" | "warn" | "error" | "silent"
VITE_LOG_LEVEL="debug"
