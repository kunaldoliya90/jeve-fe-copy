# Mode used by the Playwright suite: a real production-style build, but with
# the MSW mock backend enabled so E2E needs no live API. Loaded by
# `vite build --mode e2e` (see the `build:e2e` script).
VITE_APP_NAME="JEVE"
VITE_API_BASE_URL="/api"
VITE_API_TIMEOUT_MS="30000"
VITE_ENABLE_API_MOCKING="true"
VITE_LOG_LEVEL="warn"
